{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": false,
        "lib": [
            "ES2024",
            "DOM",
            "DOM.Iterable"
        ],
        "types": []
    },
    "include": [
        "js/**/*.js",
        "types/**/*.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
