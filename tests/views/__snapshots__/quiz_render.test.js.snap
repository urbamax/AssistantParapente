            <div style="margin-top:48px;">
                <h3 class="library-section-header" style="border:none; margin-bottom:24px;">RÉPARTITION PAR MAÎTRISE</h3>
                
            <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:16px;">
