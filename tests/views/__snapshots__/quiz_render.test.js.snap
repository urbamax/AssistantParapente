                                <div class="bank-choice" style="background: rgba(251, 146, 60, 0.15); color: var(--text-main); border: 2px solid #fb923c; padding: 12px 16px; border-radius: 8px; font-size: 0.95rem; display: flex; justify-content: space-between; align-items:center;">
