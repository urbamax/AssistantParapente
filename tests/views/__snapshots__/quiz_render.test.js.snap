                                    <span style="font-weight:bold; margin-left:12px; color:var(--text-secondary);">+2</span>
                                </div>
                                
                                <div class="bank-choice" style="background: rgba(248, 113, 113, 0.15); color: var(--text-main); border: 2px solid #f87171; padding: 12px 16px; border-radius: 8px; font-size: 0.95rem; display: flex; justify-content: space-between; align-items:center;">
                                    <span style="display:flex; align-items:center; flex:1;"><i class="ri-close-circle-fill" style="color:#dc2626; font-size:1.2rem; margin-right: 8px;"></i> <span style="flex:1;">A1V fausse</span></span>
