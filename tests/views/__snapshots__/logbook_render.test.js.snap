exports[`logbook renders (spec 014: identical before and after moving the texts) > flight form and ground handling form 1`] = `
{
  "flight": "
                <div role="button" tabindex="0" class="form-group igc-upload-container" data-action="triggerIgcUpload" style="border: 2px dashed var(--border-light, #ccc); border-radius: 8px; padding: 20px; text-align: center; margin-bottom: 15px; cursor: pointer; background: var(--bg-card, #f9f9f9);">
                    <i class="ri-upload-cloud-line" style="font-size: 2rem; color: var(--accent-blue, #007bc4);"></i>
                    <div style="font-weight: bold; margin-top: 10px;">Importer une trace GPS (.igc)</div>
                    <div style="font-size: 0.85rem; color: var(--text-secondary, #666); margin-top: 5px;" id="igc-upload-filename">Cliquez ou glissez-déposez le fichier (avec le .sdf Syride pour le facteur de charge)</div>
                </div>
                <button type="button" id="lb-igc-recalc" data-action="recalculateFromTrace" style="display:none; width: 100%; margin: -5px 0 15px; padding: 8px; border-radius: 6px; border: 1px solid var(--accent-blue, #007bc4); color: var(--accent-blue, #007bc4); background: transparent; cursor: pointer;"><i class="ri-refresh-line"></i> Recalculer depuis la trace IGC</button>
                <div class="form-group" id="igc-alt-check" style="display:none; padding: 10px 12px; border-radius: 8px; border: 1px solid var(--border-light, #ccc); margin-bottom: 15px;">
                    <div id="igc-alt-info" style="font-size: 0.85rem; margin-bottom: 8px;"></div>
                    <div style="display:flex; gap: 16px; margin-bottom: 6px; font-size: 0.9rem;">
                        <label style="display:flex; align-items:center; gap:4px;"><input type="radio" name="lb-alt-ref" value="landing" checked=""> Je connais l'altitude de l'atterrissage</label>
                        <label style="display:flex; align-items:center; gap:4px;"><input type="radio" name="lb-alt-ref" value="takeoff"> du décollage</label>
                    </div>
                    <label for="lb-real-alt">Altitude réelle (m) <small>(optionnel)</small></label>
                    <input type="number" id="lb-real-alt" style="width: 100%;" placeholder="Laisser vide pour garder l'altitude du vario">
                </div>
                <div class="form-group">
                    <label>Date &amp; Heure <span class="required">*</span></label>
                    <input type="datetime-local" id="lb-datetime" required="" value="2026-09-30T10:00">
                </div>
                <div class="form-group">
                    <label>Site de vol <span class="required">*</span></label>
                    <input type="text" id="lb-site" list="sites-list" placeholder="Ex: Planfait, Forclaz..." required="" autocomplete="off">
                    <datalist id="sites-list"><option value="MONT LAMBERT"></option><option value="PENTE ÉCOLE"></option><option value="ZZZ INCONNU"></option></datalist>
                    <div id="lb-site-choices" hidden="" style="font-size: 0.82rem; margin-top: 4px;"></div>
                    
                    <div class="lb-coords-block" style="margin-top: 6px;">
                        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.82rem;">
                            <button type="button" data-action="toggleCoordsPicker" aria-expanded="false" aria-controls="lb-coords-panel" style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border: 1px solid var(--border-light, #ccc); border-radius: var(--radius-sm); background: none; color: var(--accent-blue); cursor: pointer; font-size: 0.82rem;">
                                <i class="ri-map-pin-line" aria-hidden="true"></i> <span id="lb-coords-toggle-label">Placer sur la carte</span>
                            </button>
                            <span id="lb-coords-status" style="color: var(--text-muted);"></span>
                        </div>
                        <div id="lb-coords-panel" hidden="" style="margin-top: 8px;">
                            <label for="lb-coords">Coordonnées GPS</label>
                            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                <input type="text" id="lb-coords" autocomplete="off" spellcheck="false" placeholder="Ex : 50.68123, 1.59234" aria-describedby="lb-coords-hint lb-coords-error" style="flex: 1 1 14rem; min-width: 0;">
                                <button type="button" data-action="clearCoords" style="padding: 4px 10px; border: 1px solid var(--border-light, #ccc); border-radius: var(--radius-sm); background: none; color: var(--text-secondary); cursor: pointer; font-size: 0.82rem; white-space: nowrap;">Retirer le point</button>
                            </div>
                            <small id="lb-coords-hint" style="display: block; margin-top: 4px; color: var(--text-muted);">Cliquez sur la carte ou déplacez le repère. Vous pouvez aussi coller des coordonnées copiées depuis Google Maps (clic droit sur le lieu).</small>
                            <div id="lb-coords-error" role="alert" hidden="" style="margin-top: 4px; color: #ef4444; font-size: 0.82rem;">Coordonnées illisibles. Formats acceptés : « 50.68123, 1.59234 », « 50°40'52"N 1°35'32"E » ou un lien Google Maps.</div>
                            <div id="lb-coords-map" aria-label="Carte pour placer le lieu" style="height: 280px; margin-top: 8px; border-radius: 8px; border: 1px solid var(--border-light, #ccc);"></div>
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Voile <span class="required">*</span></label>
                        <select id="lb-voile" required=""><option value="">-- Sélectionner --</option><option value="OZONE | RUSH 6 | BLEU | M">OZONE | RUSH 6 | BLEU | M</option><option value="Autre">Autre...</option></select>
                        <input type="text" id="lb-voile-autre" list="voiles-autre-list" placeholder="Spécifiez le modèle..." autocomplete="off" style="display: none; margin-top: 5px; width: 100%;">
                        <datalist id="voiles-autre-list"><option value="OZONE | RUSH 6 | BLEU | M"></option></datalist>
                    </div>
                    <div class="form-group">
                        <label>Sellette</label>
                        <select id="lb-sellette"><option value="">-- Sélectionner --</option><option value="SUPAIR | ACCESS">SUPAIR | ACCESS</option><option value="Autre">Autre...</option></select>
                        <input type="text" id="lb-sellette-autre" list="sellettes-autre-list" placeholder="Spécifiez le modèle..." autocomplete="off" style="display: none; margin-top: 5px; width: 100%;">
                        <datalist id="sellettes-autre-list"><option value="SUPAIR | ACCESS"></option></datalist>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Durée (minutes) <span class="required">*</span></label>
                        <input type="number" id="lb-duree" min="1" placeholder="Ex: 45" required="">
                    </div>
                    <div class="form-group">
                        <label>Type de vol</label>
                        <select id="lb-typeVol">
                            <option value="Plouf">Plouf</option>
                            <option value="Thermique">Thermique</option>
                            <option value="Soaring">Soaring</option>
                            <option value="Restit">Restit</option>
                            <option value="Cross">Cross</option>
                            <option value="Treuil">Treuil</option>
                        </select>
                    </div>
                </div>

                

                <div class="form-group" style="margin-bottom: 10px;">
                    <label style="display:flex; align-items:center; gap:6px; cursor:pointer; margin-bottom: 5px;">
                        <input type="checkbox" id="lb-rescue-check" aria-controls="lb-rescue-group"> Secours ouvert ?
                    </label>
                    <div id="lb-rescue-group" hidden="">
                        <label for="lb-rescue" style="display:block; margin-bottom: 5px;">Secours utilisé</label>
                        <select id="lb-rescue" style="width:100%; padding:8px;"><option value="">-- Sélectionner --</option><option value="Autre">Autre...</option></select>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 10px;">
                    <label for="lb-tech-decollage" style="display:block; margin-bottom:5px;">Technique de décollage :</label>
                    <select id="lb-tech-decollage" style="width:100%; padding:8px;" required="" data-change-action="toggleOtherField" data-toggle-id="lb-tech-decollage-autre">
                        <option value="Face voile">Face voile</option>
                        <option value="Dos voile">Dos voile</option>
                        
                        <option value="Autre">Autre...</option>
                    </select>
                    <input type="text" id="lb-tech-decollage-autre" placeholder="Spécifiez la technique..." style="display: none; margin-top: 5px; width: 100%;">
                </div>
                <div class="form-group" id="lb-treuilleur-group" hidden="">
                    <label for="lb-treuilleur">Treuilleur</label>
                    <input type="text" id="lb-treuilleur" list="treuilleurs-list" placeholder="Nom du treuilleur" autocomplete="off" style="width: 100%;">
                    <datalist id="treuilleurs-list"></datalist>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Altitude Max (m)</label>
                        <input type="number" id="lb-altMax" placeholder="Ex: 2100">
                    </div>
                    <div class="form-group">
                        <label>Gain (m)</label>
                        <input type="number" id="lb-gain" placeholder="Ex: 800">
                    </div>
                </div>
                
                <div class="form-group">
                    <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                        <input type="checkbox" id="lb-ecole-check" aria-controls="lb-ecole-group"> Session encadrée par une école
                    </label>
                    <div id="lb-ecole-group" hidden="" style="margin-top: 6px;">
                        <label for="lb-ecole">Nom de l'école <span class="required">*</span></label>
                        <input type="text" id="lb-ecole" list="ecoles-list" placeholder="Choisir ou saisir le nom" autocomplete="off" style="width: 100%;">
                        <datalist id="ecoles-list"></datalist>
                        <label for="lb-moniteur" style="display:block; margin-top: 10px;">Moniteur</label>
                        <input type="text" id="lb-moniteur" list="moniteurs-list" placeholder="Nom du moniteur" autocomplete="off" style="width: 100%;">
                        <datalist id="moniteurs-list"></datalist>

                        <label style="display:flex; align-items:center; gap:6px; cursor:pointer; margin-top: 10px;">
                            <input type="checkbox" id="lb-stage-check" aria-controls="lb-stage-group"> C'est un stage
                        </label>
                        <div id="lb-stage-group" hidden="" style="margin-top: 6px;">
                            <label for="lb-stage-nom" style="display:block;">Nom du stage</label>
                            <input type="text" id="lb-stage-nom" placeholder="Ex: Stage perf estival" autocomplete="off" style="width: 100%;">
                            <label for="lb-stage-specialite" style="display:block; margin-top: 10px;">Spécialité</label>
                            <select id="lb-stage-specialite" style="width: 100%;">
                                <option value="">Sélectionner...</option>
                                <option value="Initiation">Initiation</option><option value="Perfectionnement">Perfectionnement</option><option value="Progression">Progression</option><option value="SIV">SIV (Simulation d'Incidents de Vol)</option><option value="Cross">Cross</option><option value="Autre">Autre</option>
                            </select>
                        </div>

                        <label style="display:block; margin-top: 10px;">Accompagnateurs</label>
                        
                        <div id="lb-accompagnateur-group" class="lb-chips"></div>
                        <datalist id="lb-accompagnateur-options"></datalist>
                        <div style="display:flex; gap:6px; margin-top:8px;">
