                        <div style="font-size: 0.8rem; margin-top: 6px; color: var(--text-secondary);"><strong>Avant révision:</strong> <span style="color:#ef4444; font-weight:bold;">Dépassé de 1h</span> (sur 1h)</div>
                    </div>
                </div><h3 class="stats-section-title">Top Lieux fréquentés</h3><div class="chart-container">
                    <div class="bar-row">
                        <div class="bar-label">Mont Lambert</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 100%; background: var(--accent-green)"></div>
                        </div>
                        <div class="bar-value">1</div>
                    </div>
                
                    <div class="bar-row">
                        <div class="bar-label">Pente école</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 100%; background: var(--accent-green)"></div>
                        </div>
                        <div class="bar-value">1</div>
                    </div>
                
                    <div class="bar-row">
                        <div class="bar-label">Zzz inconnu</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 100%; background: var(--accent-green)"></div>
                        </div>
                        <div class="bar-value">1</div>
                    </div>
                </div><h3 class="stats-section-title">Types de vols</h3><div class="chart-container">
                    <div class="bar-row">
                        <div class="bar-label">Thermique</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 50%; background: var(--accent-blue)"></div>
                        </div>
                        <div class="bar-value">1 (50%)</div>
                    </div>
                
                    <div class="bar-row">
                        <div class="bar-label">Plouf</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 50%; background: var(--accent-blue)"></div>
                        </div>
                        <div class="bar-value">1 (50%)</div>
                    </div>
                </div><h3 class="stats-section-title">Techniques de décollage</h3><div class="chart-container">
                    <div class="bar-row">
                        <div class="bar-label" title="Face voile" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Face voile</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 100%; background: #8b5cf6"></div>
                        </div>
                        <div class="bar-value">1 (100%)</div>
                    </div>
                </div><h3 class="stats-section-title">Exercices de gonflage</h3><div class="chart-container">
                    <div class="bar-row">
                        <div class="bar-label">Face voile</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 100%; background: #f59e0b"></div>
                        </div>
                        <div class="bar-value">1 (100%)</div>
                    </div>
                
                    <div class="bar-row">
                        <div class="bar-label">Vent fort</div>
                        <div class="bar-track">
                            <div class="bar-fill" style="width: 100%; background: #f59e0b"></div>
                        </div>
                        <div class="bar-value">1 (100%)</div>
                    </div>
                </div>"
`;

exports[`logbook renders (spec 014: identical before and after moving the texts) > statistics, empty 1`] = `
"
                <div class="empty-state">
                    <p>Aucune donnée pour afficher des statistiques.</p>
                </div>
            "
`;

exports[`logbook renders (spec 014: identical before and after moving the texts) > weather blocks and weather errors 1`] = `
{
  "empty": "
                <button id="refresh-weather-btn-n1" class="action-btn-text" data-action="forceWeatherRefresh" data-args="n1" style="color: var(--text-muted); cursor: pointer; border: none; background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;">
                    <i class="ri-refresh-line"></i> Récupérer la météo
                </button>
            ",
  "failed": "<div style="color: #f59e0b; font-size: 0.85rem; padding: 8px 12px; background: rgba(245,158,11,0.08); border-radius: var(--radius-sm);"><i class="ri-alert-line"></i> Météo indisponible : réseau</div>",
  "ground": "
            <div id="weather-container-g1" class="logbook-card-weather-empty" style="margin-top: 10px; font-size: 0.85rem;">
                <button id="refresh-weather-btn-g1" class="action-btn-text" data-action="forceWeatherRefresh" data-args="g1" style="color: var(--text-muted); cursor: pointer; border: none; background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;">
                    <i class="ri-refresh-line"></i> Récupérer la météo
                </button>
            </div>",
  "notFound": "<div style="color: #ef4444; font-size: 0.85rem; padding: 8px 12px; background: rgba(239,68,68,0.08); border-radius: var(--radius-sm); line-height: 1.4;"><i class="ri-error-warning-line"></i> <strong>Erreur Météo :</strong> Saisie [zzzinconnu] non trouvée dans la base des sites.<br><span style="font-size: 0.75rem; opacity: 0.8; word-break: break-all;">Échantillon base : [montlambert]</span></div>",
}
`;
