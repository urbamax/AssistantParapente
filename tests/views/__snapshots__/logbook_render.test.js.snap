                        <label>Exercices travaillés</label>
                        
                        <div id="lb-typeExercice-group" style="display:flex; flex-direction:column; gap:6px; margin-top:8px;">
                            <label><input type="checkbox" name="lb-typeExercice" value="Face voile"> Face voile</label><label><input type="checkbox" name="lb-typeExercice" value="Dos voile"> Dos voile</label><label><input type="checkbox" name="lb-typeExercice" value="Tangage/Roulis"> Tangage/Roulis</label><label><input type="checkbox" name="lb-typeExercice" value="Affalage"> Affalage</label><label><input type="checkbox" name="lb-typeExercice" value="Vent fort"> Vent fort</label><label><input type="checkbox" name="lb-typeExercice" value="Prégonflage / Démêlage"> Prégonflage / Démêlage</label>
                        </div>
                        <div style="display:flex; gap:6px; margin-top:8px;">
                            <input type="text" id="lb-typeExercice-new" data-checklist="typeExercice" placeholder="Autre exercice…" autocomplete="off" style="flex:1; min-width:0;">
                            <button type="button" class="action-btn-secondary" data-action="addChecklistItem" data-args="'typeExercice'" style="padding: 4px 10px; border-radius: 6px; cursor: pointer;"><i class="ri-add-line"></i> Ajouter</button>
                        </div>
                    </div>
                </div>
                
                <div class="form-group">
                    <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
                        <input type="checkbox" id="lb-ecole-check" aria-controls="lb-ecole-group"> Session encadrée par une école
                    </label>
                    <div id="lb-ecole-group" hidden="" style="margin-top: 6px;">
                        <label for="lb-ecole">Nom de l'école <span class="required">*</span></label>
                        <input type="text" id="lb-ecole" list="ecoles-list" placeholder="Choisir ou saisir le nom" autocomplete="off" style="width: 100%;">
                        <datalist id="ecoles-list"></datalist>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Pilotes avec qui j’ai volé</label>
                    
                        <div id="lb-pilotes-group" style="display:flex; flex-direction:column; gap:6px; margin-top:8px;">
                            
                        </div>
                        <div style="display:flex; gap:6px; margin-top:8px;">
                            <input type="text" id="lb-pilotes-new" data-checklist="pilotes" placeholder="Nom du pilote…" autocomplete="off" style="flex:1; min-width:0;">
                            <button type="button" class="action-btn-secondary" data-action="addChecklistItem" data-args="'pilotes'" style="padding: 4px 10px; border-radius: 6px; cursor: pointer;"><i class="ri-add-line"></i> Ajouter</button>
                        </div>
                </div>
                <div class="form-group">
                    <label>Commentaire</label>
                    <textarea id="lb-commentaire" rows="3" placeholder="Points à travailler..."></textarea>
                </div>
            <div id="lb-learned-summary" style="margin-top: 4px; font-size: 0.8rem; color: var(--text-secondary);">Pré-rempli d'après tes vols : voile (la dernière utilisée), sellette (la dernière utilisée). Tout reste modifiable.</div>",
}
`;

