exports[`logbook renders (spec 014: identical before and after moving the texts) > weather blocks and weather errors 1`] = `
{
  "empty": "
                <button id="refresh-weather-btn-n1" class="action-btn-text" data-action="forceWeatherRefresh" data-args="n1" style="color: var(--text-muted); cursor: pointer; border: none; background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;">
                    <i class="ri-refresh-line"></i> Récupérer la météo
                </button>
            ",
  "failed": "<div style="color: #f59e0b; font-size: 0.85rem; padding: 8px 12px; background: rgba(245,158,11,0.08); border-radius: var(--radius-sm);"><i class="ri-alert-line"></i> Météo indisponible : réseau</div>",
  "ground": "
            <div id="weather-container-g1" class="logbook-card-weather-empty" style="margin-top: 10px; font-size: 0.85rem;">
                <button id="refresh-weather-btn-g1" class="action-btn-text" data-action="forceWeatherRefresh" data-args="g1" style="color: var(--text-muted); cursor: pointer; border: none; background: rgba(0,0,0,0.03); border-radius: var(--radius-sm); padding: 6px 12px; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s;">
                    <i class="ri-refresh-line"></i> Récupérer la météo
                </button>
            </div>",
  "notFound": "<div style="color: #ef4444; font-size: 0.85rem; padding: 8px 12px; background: rgba(239,68,68,0.08); border-radius: var(--radius-sm); line-height: 1.4;"><i class="ri-error-warning-line"></i> <strong>Erreur Météo :</strong> Saisie [zzzinconnu] non trouvée dans la base des sites.<br><span style="font-size: 0.75rem; opacity: 0.8; word-break: break-all;">Échantillon base : [montlambert]</span></div>",
}
`;
