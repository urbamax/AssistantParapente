                        </tr>
                    </thead>
                    <tbody>
                <tr>
                    <td style="padding: 10px; font-weight: 700;">Mont Lambert</td>
                    <td style="padding: 10px;"><span class="weather-flyable" style="display: inline-flex; align-items: center; gap: 4px; font-weight: 600;"><i class="ri-checkbox-circle-fill"></i> Excellent (100/100)</span></td>
                    <td style="padding: 10px; text-align: center;">5h</td>
                    <td style="padding: 10px; text-align: center;">Mar 14h-17h</td>
                    <td style="padding: 10px;"><span style="color: var(--text-muted);">—</span></td>
                </tr>
            
                <tr>
                    <td style="padding: 10px; font-weight: 700;">Dune du Pyla</td>
                    <td style="padding: 10px;"><span class="weather-incomplete" style="display: inline-flex; align-items: center; gap: 4px; font-weight: 600;"><i class="ri-question-line"></i> Prévision incomplète — Indisponible : rafales</span></td>
                    <td style="padding: 10px; text-align: center;">0h</td>
                    <td style="padding: 10px; text-align: center;"><span style="color: var(--text-muted);">Aucun</span></td>
                    <td style="padding: 10px;"><span style="color: var(--text-muted);">—</span></td>
                </tr>
            
                <tr>
                    <td style="padding: 10px; font-weight: 700;">Sans météo</td>
                    <td style="padding: 10px;"><span style="color: var(--text-muted);">Chargement...</span></td>
                    <td style="padding: 10px; text-align: center;">0h</td>
                    <td style="padding: 10px; text-align: center;"><span style="color: var(--text-muted);">Aucun</span></td>
                    <td style="padding: 10px;"><span style="color: var(--text-muted);">—</span></td>
                </tr>
            </tbody>
                </table>
                <p style="margin: 12px 0 0; font-size: 0.8rem; color: var(--text-muted);">Astuce : choisis "7 Jours" dans les paramètres de calcul météo ci-dessus pour élargir la fenêtre du meilleur créneau.</p>
            </div>
        ",
}
`;

