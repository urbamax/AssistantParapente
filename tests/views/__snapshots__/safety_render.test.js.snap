            <section id="safety-panel-sigr" role="tabpanel" aria-labelledby="safety-tab-sigr" class="safety-panel" hidden="">
                
            <div class="safety-card">
                <h3><i class="ri-shield-check-line" aria-hidden="true"></i> Stratégie individuelle de gestion des risques</h3>
                <p>Inspirée du modèle de Reason : plusieurs « plaques » vous protègent de l'accident. Chacune a ses « trous » (vos lacunes). Quand ces trous s'alignent, le risque d'accident augmente.</p>
                <p><strong>Pour bâtir votre SIGR</strong> : faites le bilan des compétences nécessaires à votre pratique, identifiez celles qui vous manquent, puis acquérez-les pour « boucher les trous ».</p>
                <p class="safety-hint">Évaluez honnêtement chaque plaque. Votre bilan reste sur cet appareil.</p>
                <ul class="safety-plates"><li class="safety-plate" data-plate="pilotage">
                <div class="safety-plate-text">
                    <strong>Pilotage</strong>
                    <small>Compétences de pilotage</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Pilotage">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="pilotage" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="pilotage" data-rating="weak">À renforcer</button>
                </div>
            </li><li class="safety-plate" data-plate="aerologie">
                <div class="safety-plate-text">
                    <strong>Aérologie</strong>
                    <small>Analyse, placement…</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Aérologie">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="aerologie" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="aerologie" data-rating="weak">À renforcer</button>
                </div>
            </li><li class="safety-plate" data-plate="accidentologie">
                <div class="safety-plate-text">
                    <strong>Accidentologie</strong>
                    <small>Connaître les accidents types, avoir une culture aéronautique</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Accidentologie">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="accidentologie" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="accidentologie" data-rating="weak">À renforcer</button>
                </div>
            </li><li class="safety-plate" data-plate="materiel">
                <div class="safety-plate-text">
                    <strong>Matériel</strong>
                    <small>Choix, entretien, réglage, ergonomie</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Matériel">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="materiel" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="materiel" data-rating="weak">À renforcer</button>
                </div>
            </li><li class="safety-plate" data-plate="physique">
                <div class="safety-plate-text">
                    <strong>Condition physique</strong>
                    <small>Vue, fatigue, réflexes, maladie, gestion du froid</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Condition physique">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="physique" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="physique" data-rating="weak">À renforcer</button>
                </div>
            </li><li class="safety-plate" data-plate="communaute">
                <div class="safety-plate-text">
                    <strong>Rapport à la communauté</strong>
                    <small>Partager / demander des infos, s'intégrer dans un groupe de pilotes qui s'entraident</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Rapport à la communauté">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="communaute" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="communaute" data-rating="weak">À renforcer</button>
                </div>
            </li><li class="safety-plate" data-plate="mental">
                <div class="safety-plate-text">
                    <strong>Mental</strong>
                    <small>Gestion du stress, de l'attention, capacité à renoncer, résister aux effets de groupe</small>
                </div>
                <div class="safety-plate-rating" role="group" aria-label="Mental">
                    <button type="button" class="safety-rate safety-rate-solid" aria-pressed="false" data-action="SafetyratePlate" data-plate="mental" data-rating="solid">Solide</button><button type="button" class="safety-rate safety-rate-weak" aria-pressed="false" data-action="SafetyratePlate" data-plate="mental" data-rating="weak">À renforcer</button>
                </div>
            </li></ul>
                <p id="safety-sigr-summary" class="safety-sigr-summary" aria-live="polite"></p>
                <p class="safety-warning">La SIGR doit être continuellement réévaluée au fur et à mesure de votre progression.</p>
            </div>
            <button type="button" class="safety-source" data-action="openUrl" data-url="courses/GENERAL/affiches-pedagogiques-a3/16-sigr2019/16-sigr2019.pdf">
        <i class="ri-file-pdf-2-line" aria-hidden="true"></i> Source : affiche FFVL « La SIGR » (2019)
    </button>
        
            </section>
        "
`;
