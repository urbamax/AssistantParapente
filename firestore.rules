rules_version = '2';

// Règles Firestore d'Assistant Parapente. À déployer avec : firebase deploy --only firestore:rules
// (ou à coller dans la console Firebase > Firestore > Règles). Testées en local : npm run test:rules.
//
// Principe : chaque pilote n'accède qu'à ses propres données, sous users/{son uid}. Tout le reste
// est refusé (refus par défaut), y compris users/{uid}/pushState, réservé à la Cloud Function
// (le SDK admin ignore ces règles).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Un morceau de trace : mêmes champs et mêmes limites que js/utils/trace_codec.js
    // (12 morceaux au plus, 700 000 caractères au plus par morceau, bien sous 1 Mio par document).
    function isTracePart(partId, data) {
      return data.keys().hasAll(['flightId', 'index', 'total', 'encoding', 'data'])
        && data.keys().hasOnly(['flightId', 'index', 'total', 'encoding', 'data', 'updatedAt'])
        && data.flightId is string && data.flightId.size() > 0 && data.flightId.size() <= 64
        && data.index is int && data.index >= 0 && data.index < 12
        && data.total is int && data.total >= 1 && data.total <= 12 && data.index < data.total
        && data.encoding in ['gzip-base64', 'identity-base64']
        && data.data is string && data.data.size() > 0 && data.data.size() <= 700000
        && (!('updatedAt' in data) || data.updatedAt is number)
        && partId == data.flightId + '_' + string(data.index);
    }

    // Texte facultatif d'une fiche d'urgence : absent, ou une chaîne d'au plus `max` caractères.
    function optText(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // Fiche d'urgence (ICE) du pilote : données de santé, enregistrées seulement à sa demande expresse
    // (case « Enregistrer ma fiche dans mon profil en ligne »). Même champs que js/services/ice_service.js, avec
    // une marge sur les longueurs ; `updatedAt` départage les appareils, `consentAt` date son accord.
    function isIceProfile(docId, data) {
      return docId == 'profile'
        && data.keys().hasAll(['updatedAt', 'consentAt'])
        && data.keys().hasOnly([
          'nom', 'prenom', 'birthYear', 'birthDate', 'tel', 'langues', 'contact1Name', 'contact1Phone',
          'contact1Rel', 'contact2Name', 'contact2Phone', 'contact2Rel', 'bloodGroup', 'allergies', 'anticoag',
          'tetanos', 'pays', 'remarques', 'ffvl', 'federation', 'insurance', 'updatedAt', 'consentAt'
        ])
        && data.updatedAt is number
        && data.consentAt is string && data.consentAt.size() > 0 && data.consentAt.size() <= 40
        && optText(data, 'nom', 80) && optText(data, 'prenom', 80)
        && optText(data, 'birthYear', 4) && optText(data, 'birthDate', 10)
        && optText(data, 'tel', 40) && optText(data, 'langues', 80)
        && optText(data, 'contact1Name', 80) && optText(data, 'contact1Phone', 40) && optText(data, 'contact1Rel', 60)
        && optText(data, 'contact2Name', 80) && optText(data, 'contact2Phone', 40) && optText(data, 'contact2Rel', 60)
        && optText(data, 'bloodGroup', 8) && optText(data, 'allergies', 300) && optText(data, 'anticoag', 1)
        && optText(data, 'tetanos', 4) && optText(data, 'pays', 2) && optText(data, 'remarques', 500)
        && optText(data, 'ffvl', 40) && optText(data, 'federation', 24) && optText(data, 'insurance', 120);
    }

    match /users/{userId} {
      // Le document du compte (jeton de notification fcmToken).
      allow read, write: if isOwner(userId);

      // Seuls les sous-ensembles utilisés par l'application (js/services/firebase_service.js).
      match /logbook/{flightId} {
        allow read, write: if isOwner(userId);
      }
      match /equipment/{itemId} {
        allow read, write: if isOwner(userId);
      }
      match /stats/{statId} {
        allow read, write: if isOwner(userId);
      }
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      // Rôles du pilote (ex. { roles: ['beta'] } dans le document « profile ») : donnés à la main
      // dans la console Firebase ou par le SDK admin, jamais par l'application. Le pilote peut les
      // lire pour savoir quoi afficher, mais ne peut ni les créer, ni les modifier, ni les supprimer.
      match /access/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Traces de vol (fichiers IGC compressés, voir specs/037-sync-flight-traces) : un document par
      // morceau, nommé {identifiant du vol}_{numéro}. La forme et la taille sont contrôlées à
      // l'écriture : un client ne peut pas y ranger autre chose que des morceaux de trace.
      match /igcTraces/{partId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isTracePart(partId, request.resource.data);
      }

      // Fiche d'urgence (ICE), un seul document « profile » : lue, écrite et supprimée par son propriétaire
      // seulement ; la forme et les longueurs sont contrôlées à l'écriture.
      match /ice/{docId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isIceProfile(docId, request.resource.data);
      }
    }
  }
}
