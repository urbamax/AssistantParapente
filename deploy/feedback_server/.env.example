# Configuration du service de feedback Discord Assistant Parapente
# Ce fichier doit être copié en `.env` sur le serveur (non suivi par Git).

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
HOST=127.0.0.1
PORT=8085
ALLOWED_ORIGIN=https://assistantparapente.fr
NOTIFY_ON_START=true
